---
import Layout from '../layouts/Layout.astro';
import { resolvePath } from '../utils/paths.js';
---

<Layout title="404 - Record Not Found | Wrestling Heritage Registry">
  <div class="border border-registry-border bg-registry-surface p-8 max-w-2xl mx-auto text-center my-16 rounded-lg">
    <div class="mb-6 inline-block p-4 border border-registry-red text-registry-red rounded-full bg-registry-red/10">
      <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
    </div>
    <h1 class="font-heading font-bold text-4xl mb-4 text-registry-text">Registry Record Not Found</h1>
    <p class="font-sans text-registry-textMuted mb-8 leading-relaxed">
      The historical document you are attempting to access has either been removed from the registry, or never existed in the archive.
    </p>
    <a href={resolvePath('/')} class="inline-block bg-registry-surface hover:bg-registry-gold text-registry-text hover:text-registry-background transition-colors font-mono text-sm uppercase tracking-widest px-6 py-3 border border-registry-gold rounded focus:outline-none focus:ring-2 focus:ring-registry-gold focus:ring-offset-2 focus:ring-offset-registry-background">
      Return to Main Directory
    </a>
  </div>
</Layout>
