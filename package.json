{
  "name": "wrestling-registry",
  "version": "1.0.0",
  "type": "module",
  "description": "Wrestling Heritage Registry website",
  "scripts": {
    "test": "jest --passWithNoTests --testPathIgnorePatterns=\"e2e\"",
    "test:e2e:playwright": "playwright test",
    "lint": "eslint . --ignore-pattern '.astro/'",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build:astro": "astro build",
    "build:test": "astro build --base /",
    "sync:csv": "tsx scripts/sync-csv.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.10",
    "@types/yaml": "^1.9.7",
    "csv-stringify": "^6.9.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "knip": "^6.48.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serve": "^14.2.8",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "esbuild"
    ],
    "overrides": {
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
