---
import Layout from '../layouts/Layout.astro';
import { resolvePath } from '../utils/paths.js';
// The page renders the repo's charter Markdown directly (the same approach as the
// handbook), so edits to charter.md show up on the site automatically.
import { Content, getHeadings } from '../../charter.md';

const sections = getHeadings().filter((heading) => heading.depth === 2);
---

<Layout title="About | Wrestling Heritage Registry">
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_12rem] gap-8 items-start">
    <div class="space-y-4">
      <p class="text-sm text-registry-textMuted">
        The Wrestling Heritage Registry is the website of the International Professional Wrestling
        Heritage Registry (IPWHR), also known as “The Crabtree Catalogue” after Shirley Crabtree,
        who wrestled as <a
          href={resolvePath('/big-daddy-vs-giant-haystacks-wembley-1981')}
          class="text-registry-gold underline underline-offset-2 hover:text-registry-goldHover focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold rounded"
          >Big Daddy</a
        >. Its charter is below.
      </p>
      <article
        class="doc-prose bg-registry-surface border border-registry-border rounded-lg p-6 sm:p-8 shadow-sm"
      >
        <Content />
      </article>
    </div>

    <nav
      aria-label="Charter sections"
      class="order-first lg:order-last lg:sticky lg:top-6 bg-registry-surface border border-registry-border rounded-lg p-4 space-y-4"
    >
      <div>
        <h2 class="font-mono text-[10px] uppercase tracking-widest text-registry-textMuted mb-3">
          Charter
        </h2>
        <ol class="space-y-2 text-sm">
          {
            sections.map((section) => (
              <li>
                <a
                  href={`#${section.slug}`}
                  class="text-registry-text hover:text-registry-gold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold rounded"
                >
                  {section.text}
                </a>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="border-t border-registry-border pt-4 space-y-2 text-sm">
        <a
          href={resolvePath('/handbook')}
          class="block text-registry-gold underline underline-offset-2 hover:text-registry-goldHover focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold rounded"
          >Editorial Handbook</a
        >
        <a
          href={resolvePath('/contribute')}
          class="block text-registry-gold underline underline-offset-2 hover:text-registry-goldHover focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold rounded"
          >Contribute an entry</a
        >
      </div>
    </nav>
  </div>
</Layout>
