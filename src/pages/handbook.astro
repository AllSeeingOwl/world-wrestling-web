---
import Layout from '../layouts/Layout.astro';
import { resolvePath } from '../utils/paths.js';
// Single source of truth: the page renders the repo's handbook Markdown directly,
// so edits to wrestling_handbook.md show up on the site automatically.
import { Content, getHeadings } from '../../wrestling_handbook.md';

const sections = getHeadings().filter((heading) => heading.depth === 2);
---

<Layout title="Editorial Handbook | Wrestling Heritage Registry">
  <div class="mb-6">
    <a
      href={resolvePath('/')}
      class="text-sm text-registry-gold hover:text-registry-goldHover transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold focus-visible:ring-offset-2 focus-visible:ring-offset-registry-background rounded px-1"
      >&larr; Back to Registry</a
    >
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_12rem] gap-8 items-start">
    <article
      class="handbook bg-registry-surface border border-registry-border rounded-lg p-6 sm:p-8 shadow-sm"
    >
      <Content />
    </article>

    <nav
      aria-label="Handbook sections"
      class="order-first lg:order-last lg:sticky lg:top-6 bg-registry-surface border border-registry-border rounded-lg p-4"
    >
      <h2 class="font-mono text-[10px] uppercase tracking-widest text-registry-textMuted mb-3">
        Sections
      </h2>
      <ol class="space-y-2 text-sm">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.slug}`}
                class="text-registry-text hover:text-registry-gold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold rounded"
              >
                {section.text}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</Layout>

<style>
  .handbook {
    color: #f8fafc;
    line-height: 1.7;
  }
  .handbook :global(h1) {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #334155;
  }
  .handbook :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #f59e0b;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 1.5rem;
  }
  .handbook :global(p) {
    color: #cbd5e1;
    margin-bottom: 1rem;
  }
  .handbook :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }
  .handbook :global(ul ul) {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }
  .handbook :global(li) {
    color: #cbd5e1;
    margin-bottom: 0.5rem;
  }
  .handbook :global(li::marker) {
    color: #f59e0b;
  }
  .handbook :global(strong) {
    color: #f8fafc;
  }
</style>
