---
// A key to the registry section colours (see src/utils/sections.js).
import { REGISTRY_SECTIONS } from '../schema/archive';
import { sectionStyle } from '../utils/sections.js';
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-registry-textMuted">
  <span class="font-semibold uppercase tracking-wider" id="section-legend-label">Colour key</span>
  <ul class="contents" aria-labelledby="section-legend-label">
    {
      REGISTRY_SECTIONS.map((section) => (
        <li class="inline-flex items-center gap-2">
          <span class={`inline-block w-3 h-3 rounded-sm ${sectionStyle(section).swatch}`} aria-hidden="true" />
          <span class={sectionStyle(section).text}>{sectionStyle(section).short}</span>
        </li>
      ))
    }
  </ul>
</div>
