---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import { resolvePath } from '../utils/paths.js';

interface Props {
  title: string;
  // Shown in search results and link previews. Entry pages pass their own summary.
  description?: string;
  // 'article' for registry entries, 'website' for everything else.
  type?: 'website' | 'article';
}

const DEFAULT_DESCRIPTION =
  "The Wrestling Heritage Registry preserves professional wrestling's most significant moments, both triumphant and tragic.";

const { title, description = DEFAULT_DESCRIPTION, type = 'website' } = Astro.props;
// Absolute address of this page, for search engines and link previews.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={resolvePath('/favicon.svg')} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href={resolvePath('/sitemap.xml')} />
    <meta property="og:site_name" content="Wrestling Heritage Registry" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="bg-registry-background text-registry-text font-sans min-h-screen selection:bg-registry-gold selection:text-registry-background">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-registry-surface focus:text-registry-gold focus:border focus:border-registry-gold focus:top-0 focus:left-0">
      Skip to main content
    </a>
    <header class="bg-registry-surface mb-8 border-b border-registry-border">
      <div class="py-6 px-8 max-w-4xl mx-auto flex items-start justify-between gap-4">
        <div class="flex items-center gap-4">
          <div>
            <p class="font-heading font-bold text-3xl sm:text-4xl text-registry-text tracking-tight mb-1">
              Wrestling Heritage <span class="text-registry-gold">Registry</span>
            </p>
            <p class="font-mono text-[10px] sm:text-xs uppercase tracking-widest text-registry-textMuted">
              The Crabtree Catalogue
            </p>
          </div>
        </div>
        <div class="mt-1">
          <Navigation />
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="max-w-4xl mx-auto px-8 pb-16 outline-none">
      <slot />
    </main>

    <footer class="border-t border-registry-border mt-12 py-8 text-center bg-registry-surface">
      <div class="max-w-4xl mx-auto px-8">
        <p class="font-mono text-[10px] text-registry-textMuted uppercase tracking-widest">
          &copy; {new Date().getFullYear()} Wrestling Heritage Registry.
        </p>
      </div>
    </footer>
  </body>
</html>
