---
import Layout from '../layouts/Layout.astro';
import { resolvePath } from '../utils/paths.js';
// Single source of truth: the page renders the repo's handbook Markdown directly,
// so edits to wrestling_handbook.md show up on the site automatically.
import { Content, getHeadings } from '../../wrestling_handbook.md';

const sections = getHeadings().filter((heading) => heading.depth === 2);
---

<Layout
  title="Editorial Handbook | Wrestling Heritage Registry"
  description="Editorial standards for the Wrestling Heritage Registry: eligibility, classification, citations and how to write an entry."
>
  <div class="mb-6">
    <a
      href={resolvePath('/')}
      class="text-sm text-registry-accent underline underline-offset-2 hover:text-registry-accentHover transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-accent focus-visible:ring-offset-2 focus-visible:ring-offset-registry-background rounded px-1"
      >&larr; Back to Registry</a
    >
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_12rem] gap-8 items-start">
    <article
      class="doc-prose bg-registry-surface border border-registry-border rounded-lg p-6 sm:p-8 shadow-sm"
    >
      <Content />
    </article>

    <nav
      aria-label="Handbook sections"
      class="order-first lg:order-last lg:sticky lg:top-6 bg-registry-surface border border-registry-border rounded-lg p-4"
    >
      <h2 class="font-mono text-[10px] uppercase tracking-widest text-registry-textMuted mb-3">
        Sections
      </h2>
      <ol class="space-y-2 text-sm">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.slug}`}
                class="text-registry-text hover:text-registry-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-accent rounded"
              >
                {section.text}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</Layout>
