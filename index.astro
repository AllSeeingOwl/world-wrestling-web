---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.jsx';
import { getCollection } from 'astro:content';
import { resolvePath } from '../utils/paths.js';

const allArchiveEntries = await getCollection('archive');

const articles = allArchiveEntries.map(entry => ({
  slug: entry.id,
  title: entry.data.title,
  date: entry.data.date,
  promotion: entry.data.promotion,
  significance: entry.data.significance,
  registry_section: entry.data.registry_section,
  summary: entry.body ? entry.body.substring(0, 150) + '...' : ''
}));
---

<Layout title="Wrestling Heritage Registry">
  <div class="mb-12 border-b border-slate-200 pb-6">
    <h2 class="font-bold text-2xl mb-4">Registry Entries</h2>
    <p class="text-sm text-slate-600">Preserving professional wrestling's most significant moments.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="article-grid">
    {articles.map((article) => (
      <a
        href={resolvePath(`/archive/${article.slug}`)}
        class="block group article-item focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 rounded"
      >
        <ArticleCard article={article} />
      </a>
    ))}
  </div>
</Layout>
