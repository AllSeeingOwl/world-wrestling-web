---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { resolvePath } from '../utils/paths.js';
import CitationBlock from '../components/CitationBlock.jsx';
import CompositeScope from '../components/CompositeScope.astro';
import { formatLongDate } from '../utils/dates.js';
import { relatedEntries } from '../utils/related.js';

export async function getStaticPaths() {
  const archiveEntries = await getCollection('archive');
  return archiveEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry, related: relatedEntries(entry, archiveEntries) },
  }));
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);

const components = entry.data.components ?? [];
const lastDate = components.map((c) => c.date).sort().at(-1);
// A composite work spans dates: show the first and last parts.
const formattedDate =
  components.length > 1 && lastDate && lastDate !== entry.data.date
    ? `${formatLongDate(entry.data.date)} – ${formatLongDate(lastDate)}`
    : formatLongDate(entry.data.date);
---

<Layout title={`${entry.data.title} | Wrestling Heritage Registry`}>
  <div class="mb-6">
    <a href={resolvePath('/')} class="text-sm text-registry-gold hover:text-registry-goldHover transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold focus-visible:ring-offset-2 focus-visible:ring-offset-registry-background rounded px-1">&larr; Back to Registry</a>
  </div>
  
  <article class="bg-registry-surface border border-registry-border rounded-lg p-8 shadow-sm">
    <header class="mb-8 border-b border-registry-border pb-6">
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="px-2 py-1 bg-registry-background text-registry-textMuted text-xs font-bold rounded border border-registry-border">{entry.data.registry_section}</span>
        <span class="px-2 py-1 bg-registry-gold text-registry-background text-xs font-bold rounded">{entry.data.significance}</span>
        {entry.data.era && (
          <span class="px-2 py-1 bg-registry-background text-registry-gold text-xs font-bold rounded border border-registry-gold">{entry.data.era}</span>
        )}
        {components.length > 1 && (
          <span class="px-2 py-1 bg-registry-background text-registry-text text-xs font-bold rounded border border-registry-border">Composite work · {components.length} parts</span>
        )}
      </div>
      <h1 class="text-3xl font-heading font-bold text-registry-text mb-2">{entry.data.title}</h1>
      {entry.data.event_name && (
        <p class="text-lg text-registry-gold font-medium mb-3">{entry.data.event_name}</p>
      )}
      <div class="text-sm font-mono text-registry-textMuted flex flex-wrap gap-x-6 gap-y-2 mb-4">
        <span><strong>{components.length > 1 ? 'Dates' : 'Date'}:</strong> <time dateTime={entry.data.date}>{formattedDate}</time></span>
        <span><strong>Promotion / Creator:</strong> {entry.data.promotion}</span>
      </div>
      {entry.data.wrestlers_involved && entry.data.wrestlers_involved.length > 0 && (
        <div class="text-xs font-sans text-registry-textMuted flex flex-wrap items-center gap-2 mt-2">
          <strong class="font-mono">People Involved:</strong>
          {entry.data.wrestlers_involved.map((wrestler) => (
            <span class="px-2 py-0.5 bg-registry-background text-registry-text rounded border border-registry-border">
              {wrestler}
            </span>
          ))}
        </div>
      )}
      {entry.data.description && (
        <p class="mt-4 text-sm font-sans text-registry-text text-registry-textMuted italic border-l-2 border-registry-gold pl-3 py-1">
          {entry.data.description}
        </p>
      )}
    </header>

    {components.length > 1 && (
      <CompositeScope components={components} proposedMerit={entry.data.proposed_individual_merit} />
    )}

    {entry.data.image_url && (
      <div class="mb-8 overflow-hidden rounded-lg border border-registry-border max-h-96">
        <img src={entry.data.image_url} alt={entry.data.title} class="w-full object-cover" />
      </div>
    )}

    <div class="doc-prose max-w-none">
      <Content />
    </div>

    <CitationBlock citation={entry.data} />

    {related.length > 0 && (
      <nav aria-labelledby="see-also-heading" class="mt-8 pt-6 border-t border-registry-border">
        <h2 id="see-also-heading" class="font-mono text-xs uppercase tracking-widest text-registry-gold mb-3">See also</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {related.map((item) => (
            <li>
              <a
                href={resolvePath(`/${item.id}`)}
                class="block h-full bg-registry-background border border-registry-border rounded-lg p-3 hover:border-registry-gold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold"
              >
                <span class="block font-semibold text-sm text-registry-text">{item.title}</span>
                <span class="block mt-1 text-xs text-registry-textMuted">{item.reason}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</Layout>
