---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.jsx';
import { getCollection } from 'astro:content';
import { resolvePath } from '../utils/paths.js';
import { REGISTRY_SECTIONS } from '../schema/archive';
import { entryDecade } from '../utils/decade.js';
import { promotionGroup } from '../utils/promotion.js';

const allArchiveEntries = await getCollection('archive');

// Oldest first, so the Home page reads as a history.
const sortedEntries = [...allArchiveEntries].sort(
  (a, b) => a.data.date.localeCompare(b.data.date) || a.data.title.localeCompare(b.data.title)
);

const articles = sortedEntries.map(entry => ({
  slug: entry.id,
  title: entry.data.title,
  date: entry.data.date,
  promotion: entry.data.promotion,
  promotion_group: promotionGroup(entry.data.promotion),
  era: entryDecade(entry.data),
  significance: entry.data.significance,
  registry_section: entry.data.registry_section,
  event_name: entry.data.event_name,
  wrestlers_involved: entry.data.wrestlers_involved,
  parts: entry.data.components?.length ?? 0,
  summary: entry.data.description || (entry.body ? entry.body.substring(0, 150) + '...' : '')
}));

const promotions = [...new Set(articles.map(a => a.promotion_group))].sort((a, b) => a.localeCompare(b));
const eras = [...new Set(articles.map(a => a.era))].sort();
// Every section in charter order, with a count, so visitors see the registry's full shape
// even before a section has entries.
const sections = REGISTRY_SECTIONS.map((value) => ({
  value,
  count: articles.filter((a) => a.registry_section === value).length,
}));
---

<Layout title="Wrestling Heritage Registry">
  <div class="mb-12 border-b border-registry-border pb-6">
    <h1 class="font-bold text-2xl mb-4 text-registry-text">Registry Entries</h1>
    <p class="text-sm text-registry-textMuted">Preserving professional wrestling's most significant moments.</p>
  </div>

  <section
    aria-label="Filter registry entries"
    class="bg-registry-surface p-4 rounded-lg border border-registry-border flex flex-col md:flex-row gap-4 items-start md:items-end mb-8"
  >
    <div class="flex flex-col gap-1 w-full md:w-auto md:max-w-xs">
      <label for="promotion-filter" class="text-xs font-semibold text-registry-textMuted uppercase">Promotion / Creator</label>
      <select
        id="promotion-filter"
        class="bg-registry-background border border-registry-border text-registry-text text-sm rounded focus:ring-registry-gold focus:border-registry-gold block w-full p-2"
      >
        <option value="all">All Promotions &amp; Creators</option>
        {promotions.map((promo) => (
          <option value={promo}>{promo}</option>
        ))}
      </select>
    </div>

    <div class="flex flex-col gap-1 w-full md:w-auto">
      <label for="era-filter" class="text-xs font-semibold text-registry-textMuted uppercase">Decade</label>
      <select
        id="era-filter"
        class="bg-registry-background border border-registry-border text-registry-text text-sm rounded focus:ring-registry-gold focus:border-registry-gold block w-full p-2"
      >
        <option value="all">All Decades</option>
        {eras.map((era) => (
          <option value={era}>{era}</option>
        ))}
      </select>
    </div>

    <div class="flex flex-col gap-1 w-full md:w-auto">
      <label for="section-filter" class="text-xs font-semibold text-registry-textMuted uppercase">Registry Section</label>
      <select
        id="section-filter"
        class="bg-registry-background border border-registry-border text-registry-text text-sm rounded focus:ring-registry-gold focus:border-registry-gold block w-full p-2"
      >
        <option value="all">All Sections</option>
        {sections.map((section) => (
          <option value={section.value}>{section.value} ({section.count})</option>
        ))}
      </select>
    </div>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="article-grid">
    {articles.map((article) => (
      <a
        href={resolvePath(`/${article.slug}`)}
        class="block group article-item focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold focus-visible:ring-offset-2 focus-visible:ring-offset-registry-background rounded"
        data-promotion={article.promotion_group}
        data-era={article.era}
        data-section={article.registry_section}
      >
        <ArticleCard article={article} />
      </a>
    ))}
  </div>

  <p
    id="no-results"
    class="hidden text-sm text-registry-textMuted bg-registry-surface border border-registry-border rounded-lg p-6 text-center"
    role="status"
  >
    No entries match these filters yet.
  </p>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const promotionFilter = document.getElementById('promotion-filter') as HTMLSelectElement;
    const eraFilter = document.getElementById('era-filter') as HTMLSelectElement;
    const sectionFilter = document.getElementById('section-filter') as HTMLSelectElement;
    const noResults = document.getElementById('no-results');
    const articles = document.querySelectorAll('.article-item');

    function filterArticles() {
      const selectedPromotion = promotionFilter.value;
      const selectedEra = eraFilter.value;
      const selectedSection = sectionFilter.value;
      let visible = 0;

      articles.forEach((article) => {
        const articlePromotion = article.getAttribute('data-promotion');
        const articleEra = article.getAttribute('data-era');
        const articleSection = article.getAttribute('data-section');

        const matchPromotion = selectedPromotion === 'all' || articlePromotion === selectedPromotion;
        const matchEra = selectedEra === 'all' || articleEra === selectedEra;
        const matchSection = selectedSection === 'all' || articleSection === selectedSection;

        if (matchPromotion && matchEra && matchSection) {
          (article as HTMLElement).style.display = 'block';
          visible++;
        } else {
          (article as HTMLElement).style.display = 'none';
        }
      });

      noResults?.classList.toggle('hidden', visible > 0);
    }

    if (promotionFilter) {
      promotionFilter.addEventListener('change', filterArticles);
    }

    if (eraFilter) {
      eraFilter.addEventListener('change', filterArticles);
    }

    if (sectionFilter) {
      sectionFilter.addEventListener('change', filterArticles);
    }
  });
</script>
