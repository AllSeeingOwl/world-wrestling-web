---
import Layout from '../layouts/Layout.astro';
import ContributeForm from '../components/ContributeForm.jsx';
import { getCollection } from 'astro:content';
import { resolvePath } from '../utils/paths.js';
import { slugify } from '../utils/entry-markdown.js';

const REPO = 'AllSeeingOwl/world-wrestling-web';
// A GitHub issue form (.github/ISSUE_TEMPLATE/nomination.yml) with only the charter's four
// required details, for people who don't want to write a full entry.
const NOMINATION_URL = `https://github.com/${REPO}/issues/new?template=nomination.yml`;

const entries = await getCollection('archive');
// File names don't always match titles (montreal-screwjob.md is "The Montreal Screwjob"),
// so check new titles against both to catch duplicates and file-name clashes.
const existingSlugs = [
  ...new Set(entries.flatMap((entry) => [entry.id, slugify(entry.data.title)])),
];

// Suggestions: names already in use (so filters group entries together),
// plus the promotions named in the Editorial Handbook and every decade of televised wrestling.
const unique = (values: (string | undefined)[]) =>
  [...new Set(values.filter((v): v is string => Boolean(v)))].sort((a, b) => a.localeCompare(b));
const promotions = unique([
  ...entries.map((e) => e.data.promotion),
  'WWE',
  'WCW',
  'ECW',
  'NWA',
  'NJPW',
  'AJPW',
  'ROH',
  'TNA/Impact',
  'AEW',
]);
const eras = unique([
  ...entries.map((e) => e.data.era),
  ...['1940s', '1950s', '1960s', '1970s', '1980s', '1990s', '2000s', '2010s', '2020s'],
]);
---

<Layout
  title="Contribute | Wrestling Heritage Registry"
  description="Nominate a moment for the Wrestling Heritage Registry, or write the full entry yourself."
>
  <div class="mb-8 border-b border-registry-border pb-6">
    <h1 class="font-bold text-2xl mb-2 text-registry-text">Contribute an Entry</h1>
    <p class="text-sm text-registry-textMuted max-w-2xl">
      Propose a moment for the registry. You can send a quick nomination, or write the full entry
      yourself. An editor reviews every submission before it goes live.
    </p>
  </div>

  <section aria-label="Ways to contribute" class="mb-8 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
    <div class="bg-registry-surface border border-registry-gold rounded-lg p-4 sm:p-5 space-y-3">
      <h2 class="font-bold text-registry-text">Quick nomination</h2>
      <p class="text-registry-textMuted">
        Just what the charter asks for: the work, its promotion or creator, an approximate date, and
        a sentence or two on why it matters. It's sent as a GitHub issue, so you'll need a free
        GitHub account, but no article and no pull request.
      </p>
      <a
        href={NOMINATION_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-registry-gold hover:bg-registry-goldHover text-registry-background font-bold text-sm px-4 py-2 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-registry-surface focus-visible:ring-registry-gold"
        >Send a quick nomination<span class="sr-only"> (opens GitHub in a new tab)</span></a
      >
    </div>
    <div class="bg-registry-surface border border-registry-border rounded-lg p-4 sm:p-5 space-y-3">
      <h2 class="font-bold text-registry-text">Write the full entry</h2>
      <p class="text-registry-textMuted">
        Use the form below to write the complete entry, with citations and an article of 100 to 2,000
        words. It's checked as you go and submitted as a pull request on GitHub.
      </p>
      <a
        href="#contribute-form"
        class="inline-block text-registry-gold underline underline-offset-2 hover:text-registry-goldHover focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold rounded"
        >Go to the form</a
      >
    </div>
  </section>

  <section
    aria-labelledby="selection-heading"
    class="mb-8 bg-registry-surface border border-registry-border rounded-lg p-4 sm:p-5 text-sm space-y-3"
  >
    <h2 id="selection-heading" class="font-bold text-registry-text">How selection works</h2>
    <ul class="list-disc pl-5 space-y-2 text-registry-textMuted">
      <li>
        <strong class="text-registry-text">The charter's yearly cycle is the goal.</strong> The <a
          href={resolvePath('/about')}
          class="text-registry-gold underline underline-offset-2 hover:text-registry-goldHover focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold rounded"
          >Registry Charter</a
        > describes a public nomination period each year, review by a Preservation Board, and a class
        of inductees announced on the first Monday of the year: up to 25 for Excellence, 10 for
        Failures in Craft and 5 for Homage &amp; Influence.
      </li>
      <li>
        <strong class="text-registry-text">For now, editors review each submission.</strong> That
        cycle isn't running yet. Until it is, an editor checks every pull request against the
        charter and the Editorial Handbook, and an accepted entry is published when its pull request is merged.
      </li>
      <li>
        <strong class="text-registry-text">The Cautionary Archive isn't open to nominations.</strong>{' '}
        Its inductees are chosen privately by the Board.
      </li>
    </ul>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_15rem] gap-8 items-start">
    <div id="contribute-form" class="scroll-mt-6">
      <noscript>
        <p
          class="mb-6 p-4 bg-registry-surface border-l-4 border-registry-gold text-sm text-registry-text"
        >
          The form needs JavaScript. You can still contribute by copying <code
            >example-wrestling-entry.md</code
          > from the repository and opening a pull request.
        </p>
      </noscript>
      <ContributeForm
        client:load
        repo={REPO}
        existingSlugs={existingSlugs}
        promotions={promotions}
        eras={eras}
      />
    </div>

    <aside
      class="order-first lg:order-last space-y-4 text-sm"
      aria-label="Before you start"
    >
      <div class="bg-registry-surface border border-registry-border rounded-lg p-4 space-y-3">
        <h2 class="font-mono text-[10px] uppercase tracking-widest text-registry-textMuted">
          Before you start
        </h2>
        <ul class="space-y-2 text-registry-textMuted">
          <li>
            <strong class="text-registry-text">Be accurate.</strong> Check dates, results and names.
          </li>
          <li>
            <strong class="text-registry-text">Write as a historian,</strong> not a fan. Keep the tone
            objective.
          </li>
          <li>
            <strong class="text-registry-text">Cite your sources</strong> and explain why the moment matters.
          </li>
        </ul>
        <a
          href={resolvePath('/handbook')}
          class="inline-block text-registry-gold underline underline-offset-2 hover:text-registry-goldHover focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold rounded"
          >Read the Editorial Handbook</a
        >
      </div>

      <div class="bg-registry-surface border border-registry-border rounded-lg p-4 space-y-3">
        <h2 class="font-mono text-[10px] uppercase tracking-widest text-registry-gold">Do</h2>
        <ul class="space-y-2 text-registry-textMuted list-disc pl-4">
          <li>
            Nominate works that are <strong class="text-registry-text">at least five years old</strong
            >, so their legacy can be judged.
          </li>
          <li>
            Pick works with a <strong class="text-registry-text">verifiable public record</strong>:
            televised, streamed or distributed on a professional platform.
          </li>
          <li>
            Look <strong class="text-registry-text">worldwide</strong>. Any promotion, active or
            defunct, from any country is eligible.
          </li>
          <li>
            For a trilogy, tournament or feud, <strong class="text-registry-text"
              >define the scope</strong
            > of the composite work clearly.
          </li>
          <li>
            Consider podcasts, documentaries, YouTube series and investigative journalism that made a
            real impact.
          </li>
          <li>
            For non-English matches, explain how the story comes across <strong
              class="text-registry-text">without translated commentary</strong
            >.
          </li>
        </ul>
      </div>

      <div class="bg-registry-surface border border-registry-border rounded-lg p-4 space-y-3">
        <h2 class="font-mono text-[10px] uppercase tracking-widest text-red-400">Don't</h2>
        <ul class="space-y-2 text-registry-textMuted list-disc pl-4">
          <li>
            Don't rely on star ratings. <strong class="text-registry-text"
              >Significance, not acclaim,</strong
            > is what counts.
          </li>
          <li>
            Don't favour one promotion, era or style. The registry is <strong
              class="text-registry-text">impartial</strong
            >.
          </li>
          <li>
            Don't mock Infamy entries. Failures in Craft are <strong class="text-registry-text"
              >case studies</strong
            >, not punchlines.
          </li>
          <li>
            Don't nominate for the <strong class="text-registry-text">Cautionary Archive</strong>.
            It is chosen privately by the Preservation Board.
          </li>
          <li>
            Don't submit wrestling itself for Homage &amp; Influence. That registry is for <strong
              class="text-registry-text">works outside the industry</strong
            >.
          </li>
          <li>Don't submit more than 50 nominations in a single nomination period.</li>
        </ul>
      </div>
    </aside>
  </div>
</Layout>
