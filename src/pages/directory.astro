---
import Layout from '../layouts/Layout.astro';
import DirectoryView from '../components/DirectoryView.jsx';
import { getCollection } from 'astro:content';
import { resolvePath } from '../utils/paths.js';
import { entryDecade } from '../utils/decade.js';
import { promotionGroup } from '../utils/promotion.js';

const archiveEntries = await getCollection('archive');

// Pass only the fields the directory needs, so the page ships a small payload.
const entries = archiveEntries.map((entry) => ({
  slug: entry.id,
  url: resolvePath(`/${entry.id}`),
  title: entry.data.title,
  date: entry.data.date,
  promotion: entry.data.promotion,
  promotion_group: promotionGroup(entry.data.promotion),
  era: entryDecade(entry.data),
  event_name: entry.data.event_name,
  registry_section: entry.data.registry_section,
  description: entry.data.description,
  wrestlers_involved: entry.data.wrestlers_involved,
}));
---

<Layout
  title="Directory & Timeline | Wrestling Heritage Registry"
  description="Every entry in the Wrestling Heritage Registry, as a sortable list or a timeline, filterable by promotion, decade and registry section."
>
  <div class="mb-8 border-b border-registry-border pb-6">
    <h1 class="font-bold text-2xl mb-2 text-registry-text">Directory &amp; Timeline</h1>
    <p class="text-sm text-registry-textMuted max-w-2xl">
      Every entry in the registry. Use the master list to sort and compare, or switch to the
      timeline to follow wrestling history in order. Filter by promotion, decade or registry section,
      and group by decade as the <a
        href={resolvePath('/handbook')}
        class="text-registry-gold underline underline-offset-2 hover:text-registry-goldHover focus:outline-none focus-visible:ring-2 focus-visible:ring-registry-gold rounded"
        >Editorial Handbook</a
      > recommends.
    </p>
  </div>

  <noscript>
    <p
      class="mb-6 p-4 bg-registry-surface border-l-4 border-registry-gold text-sm text-registry-text"
    >
      Sorting, filters and the timeline need JavaScript. The full list is shown below.
    </p>
  </noscript>

  <DirectoryView entries={entries} client:idle />
</Layout>
